--- /dev/null
+++ b/C64Emulator/Machine/TapImage.cs
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: Apache-2.0
+// Raw timing representation; no program/ROM decoding or loader shortcut.
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Text;
+
+namespace C64Emulator.Core
+{
+    public sealed class TapImage
+    {
+        public byte Version { get; private set; }
+        public byte VideoStandard { get; private set; }
+        public int[] Durations { get; private set; }
+        public double ClockHz => ClockFor(VideoStandard);
+        public bool HalfWaves => Version == 2;
+
+        private TapImage() { Durations = Array.Empty<int>(); }
+
+        public static double ClockFor(byte videoStandard)
+        {
+            return videoStandard switch
+            {
+                0 => 985248.0,
+                1 or 2 => 1022727.0,
+                3 => 1023440.0,
+                _ => throw new InvalidDataException("Unknown C64 TAP video standard.")
+            };
+        }
+
+        public static TapImage Parse(byte[] bytes)
+        {
+            if (bytes == null || bytes.Length < 20 ||
+                Encoding.ASCII.GetString(bytes, 0, 12) != "C64-TAPE-RAW")
+                throw new InvalidDataException("Not a C64 TAP image.");
+            if (bytes[12] > 2 || bytes[13] != 0 || bytes[15] != 0)
+                throw new InvalidDataException("Unsupported TAP version, machine or reserved field.");
+            _ = ClockFor(bytes[14]);
+            uint length = (uint)(bytes[16] | bytes[17] << 8 | bytes[18] << 16 | bytes[19] << 24);
+            if (length != bytes.Length - 20)
+                throw new InvalidDataException("TAP payload length does not match its header.");
+            var pulses = new List<int>();
+            for (int i = 20; i < bytes.Length; i++)
+            {
+                int duration = bytes[i] * 8;
+                if (duration == 0)
+                {
+                    if (bytes[12] == 0) duration = 2048;
+                    else
+                    {
+                        if (i + 3 >= bytes.Length) throw new InvalidDataException("Truncated extended TAP pulse.");
+                        duration = bytes[++i] | bytes[++i] << 8 | bytes[++i] << 16;
+                        if (duration == 0) throw new InvalidDataException("A TAP pulse must have a positive duration.");
+                    }
+                }
+                pulses.Add(duration);
+            }
+            return new TapImage { Version = bytes[12], VideoStandard = bytes[14], Durations = pulses.ToArray() };
+        }
+
+        public static byte[] Encode(IEnumerable<int> durations, byte videoStandard = 0, byte version = 1)
+        {
+            if (version > 2) throw new ArgumentOutOfRangeException(nameof(version));
+            _ = ClockFor(videoStandard);
+            using var stream = new MemoryStream();
+            using var writer = new BinaryWriter(stream);
+            writer.Write(Encoding.ASCII.GetBytes("C64-TAPE-RAW"));
+            writer.Write(version); writer.Write((byte)0); writer.Write(videoStandard); writer.Write((byte)0);
+            writer.Write(0);
+            foreach (int duration in durations)
+            {
+                if (duration <= 0 || duration > 0xFFFFFF) throw new ArgumentOutOfRangeException(nameof(durations));
+                if (duration % 8 == 0 && duration <= 2040) writer.Write((byte)(duration / 8));
+                else if (version == 0 && duration == 2048) writer.Write((byte)0);
+                else if (version == 0) throw new InvalidDataException("TAP v0 cannot represent this cycle-exact pulse.");
+                else
+                {
+                    writer.Write((byte)0);
+                    writer.Write((byte)duration); writer.Write((byte)(duration >> 8)); writer.Write((byte)(duration >> 16));
+                }
+            }
+            writer.Flush();
+            stream.Position = 16;
+            writer.Write(checked((uint)(stream.Length - 20)));
+            writer.Flush();
+            return stream.ToArray();
+        }
+    }
+}
diff --git a/C64Emulator/Machine/TapeDeck.cs b/C64Emulator/Machine/TapeDeck.cs
new file mode 100644
--- /dev/null
+++ b/C64Emulator/Machine/TapeDeck.cs
@@ -0,0 +1,164 @@
+// SPDX-License-Identifier: Apache-2.0
+// Cycle-driven cassette transport: 6510 motor/WRITE pins and CIA1 FLAG READ.
+using System;
+using System.Collections.Generic;
+using System.IO;
+
+namespace C64Emulator.Core
+{
+    public sealed class TapeDeck
+    {
+        private int[] _pulses = Array.Empty<int>();
+        private List<int> _recorded = new List<int>();
+        private byte _version = 1, _videoStandard;
+        private double _cpuHz = 985248.0, _sourceHz = 985248.0, _rounding;
+        private int _position, _remaining, _currentDuration;
+        private long _recordElapsed;
+        private bool _playing, _recording, _motorOn, _writeHigh = true, _readHigh = true;
+        private bool _recordEdgeSeen, _halfWaveHigh;
+
+        public bool MotorOn => _motorOn;
+        public bool IsPlaying => _playing;
+        public bool IsRecording => _recording;
+        public bool SensePressed => _playing || _recording;
+        public bool ReadHigh => _readHigh;
+        public bool EndOfTape => _playing && _position >= _pulses.Length && _remaining == 0;
+        public int Position => _position;
+        public int PulseCount => _recording || _recorded.Count > 0 ? _recorded.Count : _pulses.Length;
+        public byte VideoStandard => _videoStandard;
+        public int[] RecordedPulses => _recorded.ToArray();
+
+        public void ConfigureClock(double cpuHz)
+        {
+            if (cpuHz < 100000 || cpuHz > 2000000) throw new ArgumentOutOfRangeException(nameof(cpuHz));
+            _cpuHz = cpuHz;
+        }
+
+        public void Mount(byte[] bytes)
+        {
+            // Parse completely before changing the mounted tape.
+            TapImage image = TapImage.Parse(bytes);
+            Stop();
+            _pulses = image.Durations;
+            _version = image.Version;
+            _videoStandard = image.VideoStandard;
+            _sourceHz = image.ClockHz;
+            _recorded.Clear();
+            Rewind();
+        }
+
+        public void Play()
+        {
+            if (_recorded.Count > 0)
+            {
+                _pulses = _recorded.ToArray();
+                _recorded.Clear();
+                _version = 1;
+            }
+            _recording = false;
+            _playing = true;
+            _readHigh = true;
+        }
+
+        public void Record(byte videoStandard = 0)
+        {
+            _sourceHz = TapImage.ClockFor(videoStandard);
+            _videoStandard = videoStandard;
+            _version = 1;
+            _playing = false;
+            _recording = true;
+            _recorded.Clear();
+            _pulses = Array.Empty<int>();
+            Rewind();
+            _recordElapsed = 0;
+            _recordEdgeSeen = false;
+            _readHigh = true;
+        }
+
+        public void Stop()
+        {
+            _playing = false;
+            _recording = false;
+            _readHigh = true;
+            _recordEdgeSeen = false;
+            _recordElapsed = 0;
+        }
+
+        public void Eject()
+        {
+            Stop();
+            _pulses = Array.Empty<int>();
+            _recorded.Clear();
+            _version = 1;
+            _videoStandard = 0;
+            _sourceHz = 985248.0;
+            Rewind();
+        }
+
+        public void Rewind()
+        {
+            _position = _remaining = _currentDuration = 0;
+            _rounding = 0;
+            _halfWaveHigh = false;
+            _readHigh = true;
+        }
+
+        public byte[] ExportTap()
+        {
+            return TapImage.Encode(_recorded.Count > 0 ? _recorded : _pulses, _videoStandard,
+                _recorded.Count > 0 ? (byte)1 : _version);
+        }
+
+        public void WriteProcessorPort(byte direction, byte data)
+        {
+            // Cassette motor is active low. Input pins are pulled up.
+            byte pins = (byte)((data & direction) | ~direction);
+            bool motor = (pins & 0x20) == 0;
+            bool write = (pins & 0x08) != 0;
+            if (_recording && motor && _motorOn && !_writeHigh && write)
+            {
+                if (_recordEdgeSeen)
+                {
+                    double scaled = _recordElapsed * _sourceHz / _cpuHz;
+                    int duration = checked((int)Math.Round(scaled));
+                    if (duration <= 0 || duration > 0xFFFFFF)
+                        throw new InvalidDataException("Recorded cassette pulse is outside TAP v1 range.");
+                    _recorded.Add(duration);
+                }
+                _recordElapsed = 0;
+                _recordEdgeSeen = true;
+            }
+            _writeHigh = write;
+            _motorOn = motor;
+        }
+
+        public void Tick()
+        {
+            if (!_motorOn) return;
+            if (_recording)
+            {
+                _recordElapsed++;
+                return;
+            }
+            if (!_playing) return;
+            if (_remaining == 0)
+            {
+                if (_position >= _pulses.Length) { _readHigh = true; return; }
+                double scaled = _pulses[_position] * _cpuHz / _sourceHz + _rounding;
+                _currentDuration = Math.Max(1, (int)Math.Round(scaled));
+                _rounding = scaled - _currentDuration;
+                _remaining = _currentDuration;
+            }
+            _remaining--;
+            if (_version == 2)
+            {
+                if (_remaining == 0) { _halfWaveHigh = !_halfWaveHigh; _readHigh = _halfWaveHigh; _position++; }
+            }
+            else
+            {
+                if (_remaining == _currentDuration / 2) _readHigh = true;
+                if (_remaining == 0) { _readHigh = false; _position++; }
+            }
+        }
+    }
+}
